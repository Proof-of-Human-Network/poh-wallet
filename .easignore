# Files excluded from the EAS Build upload tarball.
#
# When this file exists EAS uses it INSTEAD of .gitignore, so everything that
# should stay out of the upload has to be listed here — including the usual
# .gitignore entries.
#
# The local native build output is the big one: android/app/build and
# android/.gradle are ~1.2GB here and are rebuilt from scratch on the EAS
# worker, so shipping them only slows the upload down.

node_modules/
.git/

# Local native build output — regenerated by the build worker
android/build/
android/app/build/
android/.gradle/
android/.idea/
android/local.properties
ios/build/
ios/Pods/
ios/DerivedData/

# Expo / Metro caches
.expo/
.expo-shared/
dist/
web-build/
.metro-health-check*

# Editor and OS noise
.vscode/
.idea/
*.tsbuildinfo
.DS_Store
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# Secrets never belong in a build tarball
.env
.env.local
*.jks
*.p8
*.p12
*.key
*.mobileprovision
